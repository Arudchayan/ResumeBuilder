{
  "name": "resume-builder",
  "version": "2.0.0",
  "private": true,
  "description": "State-of-the-art local-first Resume Builder (monorepo)",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @resume/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @resume/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm -r build",
    "pretypecheck": "pnpm -r build"
  },
  "keywords": [
    "resume",
    "cv",
    "builder",
    "pdf",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
